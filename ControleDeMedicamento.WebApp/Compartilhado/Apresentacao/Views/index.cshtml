@{
    Layout = "_Layout";
}

<div class="row" data-bs-theme="dark">
    <div class="col-lg-7">
        <h1 class="display-5 fw-semibold mb-3">Controle de Medicamento</h1>
        <p class="lead text-secondary mb-4">
            Organize seus Medicamentos
        </p>
           
            <div class="container mt-3">
                <div class="d-flex flex-wrap gap-3 justify-content-center">
                    <button class="btn btn-primary">Módulo Fornecedores</button>
                    <button class="btn btn-primary">Módulo Pacientes</button>
                    <button class="btn btn-primary">Módulo Medicamentos</button>
                    <button class="btn btn-primary">Módulo Funcionário</button>
                    <button class="btn btn-primary">Módulo Entrada</button>
                    <button class="btn btn-primary">Módulo Saídas</button>
                </div>
                </div>
            </div>
           

                <div class="col-lg-5">
                    <div class="card border-primary-subtle shadow-sm">
                        <div class="card-body p-4">
                            <h3 class="h5 text-primary mb-3">Módulos disponíveis</h3>

                            <div class="list-group">
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                   asp-controller="Fornecedores" asp-action="Listar">
                                    Modulo Fornecedores
                                    <span class="badge text-bg-primary rounded-pill">Abrir</span>
                                </a>

                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                   asp-controller="Paciente" asp-action="Listar">
                                    Modulo Paciente
                                    <span class="badge text-bg-primary rounded-pill">Abrir</span>
                                </a>

                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                   asp-controller="Medicamentos" asp-action="Listar">
                                    Modulo Medicamentos
                                    <span class="badge text-bg-primary rounded-pill">Abrir</span>
                                </a>

                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                   asp-controller="Funcionario" asp-action="Listar">
                                    Modulo Funcionarios
                                    <span class="badge text-bg-primary rounded-pill">Abrir</span>
                                </a>

                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                   asp-controller="Entrada" asp-action="Listar">
                                    Modulo Requisicao de Entrada 
                                    <span class="badge text-bg-primary rounded-pill">Abrir</span>
                                </a>

                                   <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                   asp-controller="Saida" asp-action="Listar">
                                    Modulo Requisicao de Entrada 
                                    <span class="badge text-bg-primary rounded-pill">Abrir</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>