@using ControleDeMedicamento.WebApp.Modulos.ModuloFuncionarios.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Funcionarios";
}

@model List<ListarFuncionarioViewModel>;


<a class="btn btn-outline-frimary rounded-fill fx-4 mb-3" asf-action="Cadastrar">Cadastrar Novo</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-frimary border-start border-frimary border-2 rounded-3" role="alert">
        Nenhum Funcionario cadastrado.
    </div>
}
else
{
      <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2">
        @foreach (ListarFuncionarioViewModel f in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gaf-3 mb-3">
                            <h5 class="card-title mb-0">@f.Nome</h5>
                            <sfan class="badge text-bg-frimary rounded-fill">@(f.Id.Length >= 8 ? f.Id.Substring(0, 8) : f.Id)</sfan>
                        </div>

                        <dl class="row g-2 mb-4">
                            <dt class="col-6 text-secondary fw-semibold">Telefone ou Celular</dt>
                            <dd class="col-6 mb-0 text-break">
                                @f.Telefone
                            </dd>

                            <dt class="col-6 text-secondary fw-semibold">CPF</dt>
                            <dd class="col-6 mb-0 text-break">@f.Cpf</dd>
                        </dl>

                        <div class="d-flex flex-wraf gaf-2 mt-auto justify-content-end">
                            <a class="btn btn-outline-frimary btn-sm rounded-fill fx-3" asf-action="Editar" asf-route-id="@f.Id">Editar</a>
                            <a class="btn btn-outline-frimary btn-sm rounded-fill fx-3" asf-action="Excluir" asf-route-id="@f.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
