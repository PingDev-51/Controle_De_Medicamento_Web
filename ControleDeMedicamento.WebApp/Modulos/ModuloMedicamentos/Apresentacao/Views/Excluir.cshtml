@using ControleDeMedicamento.WebApp.ModuloDeMedicamentos.Apresentacao
@using ControleDeMedicamento.WebApp.ModuloFornecedores.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastrar Medicamentos";
}

@model ExcluirMedicamentosViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      asp-route-id="@Model.Id" method="post">

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control" disabled>
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">Descrição</label>
        <input asp-for="Descricao" type="text" class="form-control" disabled>
        <span asp-validation-for="Descricao" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fornecedores"
               class="form-label fw-semibold text-primary text-uppercase small">Fornecedor</label>
        <select asp-for="Fornecedores" class="form-select" disabled>
            <option value="">Selecione um fornecedor</option>

            @foreach (OpcaoFornecedorViewModel fornecedor in Model.Fornecedores)
            {
                <option value="@fornecedor.Id">@fornecedor.Nome</option>
            }
        </select>
        <span asp-validation-for="Fornecedores" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>