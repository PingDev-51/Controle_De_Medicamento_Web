@using ControleDeMedicamento.WebApp.Modulos.ModuloEstoque.RequisicaoDeSaida.Apresentacao

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Registrar Saída";
}

@model CadastrarSaidaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar"
      method="post">
    <div class="mb-3">
        <label asp-for="PacienteId" class="form-label fw-semibold text-primary text-uppercase small">Paciente</label>
        <select asp-for="PacienteId" class="form-select">
            <option value="">Selecione um Paciente</option>
            @foreach (OpcaoPacienteViewModel paciente in Model.Pacientes)
            {
                <option value="@paciente.Id">@paciente.Nome</option>
            }
        </select>
        <span asp-validation-for="PacienteId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MedicamentoId" class="form-label fw-semibold text-primary text-uppercase small">Medicamentos</label>
        <select asp-for="MedicamentoId" class="form-select">
            <option value="">Selecione um mecicamento</option>
            @foreach (OpcaoMedicamentosViewModel medicamento in Model.Medicametos)
            {
                <option value="@medicamento.Id">@medicamento.Nome</option>
            }
        </select>
        <span asp-validation-for="MedicamentoId" class="text-danger small fw-semibold"></span>
    </div>

      <div class="mb-3">
        <label asp-for="QuantidadeSaida" class="form-label fw-semibold text-primary text-uppercase small">Quantidade De Saida</label>
        <input asp-for="QuantidadeSaida" type="number" class="form-control">
        <span asp-validation-for="QuantidadeSaida" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        @if (Model.Pacientes.Count == 0 || Model.Medicametos.Count == 0)
        {
            <button class="btn btn-primary rounded-pill px-4" type="submit" disabled>Confirmar</button>
        }
        else
        {
            <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
        }
    </div>
</form>